#======================================
#		Compilacion del proyecto
#======================================

# Primero definimos las variables
CC 	   := gcc
TARGET := restaurante

SRC_DIR := src
INC_DIR := include
BUILD   := build


# Definimos las banderas a usar para el compilador
CFLAGS  := -stc=c99 -Wall -Wextra -Wpedantic -I$(INC_DIR) -I$(SRC_DIR)
LDFLAGS :=
LDLIBS  :=

# Este detectara automaticamente todos los .c (no hay que editar al agregar archivos)
SRCS := $(wildcard $(SRC_DIR)/*.c)
OBJS := $(SRCS:$(SRC_DIR)/%.c=$(BUILD)/%.o)
DEPS := $(OBJS:.o=.d)

.PHONY: all debug release run clean help

# MODOS DE COMPILACION
all: CFLAGS += -g -O0
all: $(TARGET)

debug: CFLAGS  += -g -O0 -fsanitize=address,undefined
debug: LDFLAGS += -fsanitize=address,undefined
debug: $(TARGET)

# Enlazar los .c y los .o
$(TARGET): $(OBJS)
	$(CC) $(OBJS) -o $@ $(LDFLAGS) $(LDLIBS)
	
# Compilacion de cada .c
# -MMD y -MP generan dependencias: si se cambia un .h se recompila lo necesario
$(BUILD)/%.o: $(SRC_DIR)/%.c | $(BUILD)
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

# Identificamos si se usa un sistema Windows o UNIX based
ifeq ($(OS),Windows_NT)
	MKDIR = if not exist "$(BUILD)" mkdir "$(BUILD)"
else
	MKDIR = mkdir -p "$(BUILD)"
endif

$(BUILD):
	$(MKDIR)
	
# Utilidades:

run: all
	./$(TARGET)
	
clean:
	rm -rf $(BUILD) $(TARGET)


help:
	@echo "Uso: make [objetivo]"
	@echo "  all      Compila con símbolos de depuración (por defecto)"
	@echo "  debug    Compila con sanitizers (detecta errores de memoria)"
	@echo "  release  Compila optimizado"
	@echo "  run      Compila y ejecuta"
	@echo "  clean    Borra objetos y ejecutable"
	@echo "Nota: al cambiar de modo, haz 'make clean' primero."
 
-include $(DEPS)